[sub_resource type="GDScript" id="GDScript_l1o4d"]
script/source = "
extends CharacterBody2D

const SPEED = 80.0
const DAMAGE = 10
const ATTACK_DISTANCE = 35.0
const ATTACK_COOLDOWN = 1.0

@onready var anim: AnimatedSprite2D = $AnimatedSprite2D
@onready var attack_range: Area2D = $AttackDerection/Attack 

var health = 50
var alive = true
var chase = false
var attacking = false
var attack_timer = 0.0
var player: Node2D = null


func _ready():
	attack_range.body_entered.connect(_on_attack_range_body_entered)
	attack_range.body_exited.connect(_on_attack_range_body_exited)
	anim.animation_finished.connect(_on_animation_finished)

	player = get_tree().root.find_child(\"Player\", true, false)


func _physics_process(delta):
	if not alive:
		return

	if not is_on_floor():
		velocity += get_gravity() * delta

	attack_timer = maxf(attack_timer - delta, 0.0)

	if not is_instance_valid(player):
		player = get_tree().root.find_child(\"Player\", true, false)

	if not is_instance_valid(player) or not chase:
		velocity.x = move_toward(velocity.x, 0.0, SPEED)

		if not attacking and anim.animation != \"Idle\":
			anim.play(\"Idle\")

		move_and_slide()
		return

	var distance_x = absf(player.global_position.x - global_position.x)
	var distance_y = absf(player.global_position.y - global_position.y)

	anim.flip_h = player.global_position.x < global_position.x

	if distance_x > ATTACK_DISTANCE:
		velocity.x = signf(player.global_position.x - global_position.x) * SPEED

		if not attacking and anim.animation != \"Run\":
			anim.play(\"Run\")
	else:
		velocity.x = 0.0

		if not attacking and attack_timer <= 0.0 and distance_y < 50.0:
			attack()

		elif not attacking and anim.animation != \"Idle\":
			anim.play(\"Idle\")

	move_and_slide()


func attack():
	if not alive or not is_instance_valid(player):
		return

	attacking = true
	attack_timer = ATTACK_COOLDOWN
	anim.play(\"Attack\")

	if absf(player.global_position.x - global_position.x) <= ATTACK_DISTANCE + 10.0:
		if absf(player.global_position.y - global_position.y) < 50.0:
			if player.has_method(\"take_damage\"):
				player.take_damage(DAMAGE)


func _on_animation_finished():
	if anim.animation == \"Attack\":
		attacking = false

		if alive:
			anim.play(\"Idle\")

	elif anim.animation == \"Damage\":
		if alive:
			anim.play(\"Idle\")

	elif anim.animation == \"Death\":
		queue_free()


func _on_attack_range_body_entered(body):
	if body.name == \"Player\":
		player = body
		chase = true


func _on_attack_range_body_exited(body):
	if body == player:
		chase = false
		velocity.x = 0.0


func take_damage(amount: int):
	if not alive:
		return

	health -= amount

	if health <= 0:
		die()
	else:
		anim.play(\"Damage\")


func die():
	if not alive:
		return

	alive = false
	chase = false
	attacking = false
	velocity = Vector2.ZERO
	anim.play(\"Death\")
"

