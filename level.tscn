[sub_resource type="GDScript" id="GDScript_vlyqg"]
script/source = "
extends Node2D

@onready var light = $DirectionalLight2D
@onready var pointLight = $PointLight2D
@onready var day_text = $CanvasLayer/DayText
@onready var animPlayer = $CanvasLayer/AnimationPlayer

enum {
	MORNING,
	NIGHT
}

var state = MORNING
var day_count = 1


func _ready():
	# Начинаем с утра
	state = MORNING
	day_count = 1

	light.enabled = true

	# Утром свет возле персонажа выключен
	pointLight.enabled = false
	pointLight.energy = 0.0

	morning_state()

	set_day_text()
	day_text_fade()


func morning_state():
	# Плавно увеличиваем дневное освещение
	var tween = get_tree().create_tween()
	tween.tween_property(light, \"energy\", 0.95, 20)

	# Плавно выключаем свет персонажа
	if pointLight.enabled:
		var tween1 = get_tree().create_tween()
		tween1.tween_property(pointLight, \"energy\", 0.0, 2.0)
		tween1.tween_callback(
			func(): pointLight.enabled = false
		)


func night_state():
	# Плавно уменьшаем дневное освещение
	var tween = get_tree().create_tween()
	tween.tween_property(light, \"energy\", 0.2, 20)

	# Включаем свет возле персонажа
	pointLight.enabled = true
	pointLight.energy = 0.0

	var tween1 = get_tree().create_tween()
	tween1.tween_property(pointLight, \"energy\", 1.5, 20)


func _on_day_night_timeout():
	if state == MORNING:
		# Утро закончилось — начинается ночь
		state = NIGHT
		night_state()

	else:
		# Ночь закончилась — начинается новое утро
		state = MORNING

		day_count += 1
		set_day_text()
		day_text_fade()

		morning_state()


func day_text_fade():
	animPlayer.play(\"day_text_fade_in\")

	await get_tree().create_timer(3).timeout

	animPlayer.play(\"day_text_fade_out\")


func set_day_text():
	day_text.text = \"DAY \" + str(day_count)
"

